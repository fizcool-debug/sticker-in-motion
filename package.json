{
  "name": "sticker-in-motion",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "studio": "npm --prefix animation run dev",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "powershell -NoProfile -File scripts/build-android.ps1",
    "android:publish": "powershell -NoProfile -File scripts/publish-android-release.ps1",
    "test": "node scripts/verify-stabilizer.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "targets:compile": "node scripts/compile-collection.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@remotion/player": "4.0.534",
    "mind-ar": "1.2.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.534",
    "three": "0.160.0"
  },
  "overrides": {
    "tar": "^7.5.21"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@fontsource/space-grotesk": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "latest",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "latest"
  },
  "description": "An offline Android AR sticker app with image tracking and animated artwork.",
  "license": "MIT",
  "author": "Bhawesh Kumar",
  "repository": {
    "type": "git",
    "url": "https://github.com/fizcool-debug/sticker-in-motion.git"
  },
  "bugs": {
    "url": "https://github.com/fizcool-debug/sticker-in-motion/issues"
  },
  "homepage": "https://github.com/fizcool-debug/sticker-in-motion#readme",
  "engines": {
    "node": ">=24"
  }
}
