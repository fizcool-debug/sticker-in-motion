  "narrative": {
    "northStar": "The camera and sticker lead",
    "overview": "The confirmed camera-first concept lets each sticker artwork lead. Sticker in Motion is the provisional app identity; CET is only the first test asset. Near-black ink, white controls, and self-hosted Space Grotesk keep the interface quiet and readable around changing camera frames. Preserve each supplied sticker artwork and show its name only when recognized or selected for preview.\n\nScanning uses a full-height camera surface; the separate animation preview uses a square Player and explanatory caption. These describe the current surfaces, not a mandatory composition for every future page. Recovery remains actionable within the scanner canvas.",
    "keyCharacteristics": [
      "Camera-led composition with quiet controls.",
      "Solid ink surfaces and high-contrast actions.",
      "Rainbow belongs to the supplied artwork.",
      "Preview is explicitly distinguished from AR tracking."
    ],
    "rules": [
      {
        "name": "The Artwork Rainbow Rule",
        "body": "Keep rainbow color inside the supplied artwork; do not spread it into a blanket interface gradient.",
        "section": "colors"
      },
      {
        "name": "The Tight-but-readable Rule",
        "body": "The current type system never tracks tighter than -0.03em.",
        "section": "typography"
      },
      {
        "name": "The Solid Surface Rule",
        "body": "Place readable controls on solid ink surfaces when the camera background can vary.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve supplied CET lettering, rainbow bar, and proportions.",
      "Do keep controls on solid surfaces around the changing camera image.",
      "Do retain visible focus outlines and at least 48px button targets.",
      "Do label the animation preview distinctly from verified AR tracking."
    ],
    "donts": [
      "Don't apply the artwork's rainbow as a blanket UI gradient.",
      "Don't use decorative looping motion in scanner controls.",
      "Don't claim physical tracking is verified from a preview or synthetic camera recovery capture."
    ]
  }
